#!/bin/bash
# greeter - dynamic banner script for Part C1

current_user=$(whoami)
logged_in_count=$(who | wc -l)
sys_uptime=$(uptime -p)

messages=(
  "Stock levels are stable today."
  "Remember to check the swarm logs before launch."
  "TechCorp launch is almost here — stay sharp."
)

random_index=$(( RANDOM % ${#messages[@]} ))
random_message="${messages[$random_index]}"

echo "=================================="
echo " Welcome, $current_user"
echo " Logged-in users on this server: $logged_in_count"
echo " System uptime: $sys_uptime"
echo " Message of the moment: $random_message"
echo "=================================="
